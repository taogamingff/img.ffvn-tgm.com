{
  "rewrites": [
    {
      "source": "/images/:filename",
      "destination": "/api/upload?filename=:filename"
    }
  ],
  "headers": [
    {
      "source": "/images/:filename",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
